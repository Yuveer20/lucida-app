# ---------------------------------------------------------------------------
# Provider — auto-selected, not something you normally set directly.
#
# ANTHROPIC_API_KEY takes priority over GROQ_API_KEY when both are present, so
# the intended flow is: run on Groq now, add an Anthropic key later, and every
# boot after that switches to Anthropic automatically. See
# docs/Technical_Design.md §1b for why Groq exists at all (short version: it's
# a stopgap with a real gap — its structured-output schema is enforced by
# instruction, not by the API, unlike Anthropic's).
#
# Uncomment to force one or the other regardless of which keys are set:
# LUCIDA_PROVIDER=anthropic
# LUCIDA_PROVIDER=groq
# ---------------------------------------------------------------------------

# Anthropic API — the primary path. Structured outputs, adaptive thinking,
# prompt caching. Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Groq API — stopgap path, used automatically until ANTHROPIC_API_KEY is set.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Groq's catalog turns over — check https://console.groq.com/docs/models if
# this 404s with model_not_found.
GROQ_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Model + cost. See docs/Technical_Design.md §4.9 / §4.9a for the full cost
# model and the levers below, ordered by impact. These apply to whichever
# provider is active; LUCIDA_MODEL overrides that provider's default model
# (claude-sonnet-5 for Anthropic, GROQ_MODEL for Groq).
# ---------------------------------------------------------------------------

# LUCIDA_MODEL=claude-sonnet-5

# Student Agents are the cost centre — their call count scales with the roster
# and they dominate total spend. Pointing them at a cheaper tier than the
# critique agents is the largest single lever (Anthropic only — Groq has one
# model tier here). Defaults to LUCIDA_MODEL.
# LUCIDA_STUDENT_MODEL=claude-haiku-4-5

# How many of the 18 personas share one call.
#   1 = 18 calls, highest fidelity (default)
#   3 = 6 calls, ~3x cheaper on the dominant cost
#   6 = 3 calls, cheapest, highest risk of profiles blurring together
LUCIDA_PERSONAS_PER_CALL=1

# Repeat passes per persona. 1 is the documented budget. Confidence ranges no
# longer depend on this being >1 — each pass reports its own band — so extra
# passes buy stability, not the range itself.
LUCIDA_STUDENT_PASSES=1

# Effort (Anthropic only — Groq has no equivalent and ignores this). Student
# Agents are simulating, not analysing; the critique and QA agents are where
# reasoning quality actually shows up.
LUCIDA_STUDENT_EFFORT=medium
LUCIDA_CRITIQUE_EFFORT=high

# Max concurrent LLM requests.
LUCIDA_CONCURRENCY=6

# Groq only. Free/on-demand Groq tiers cap tokens-per-minute per request, not
# just cumulatively — a single call requesting more than the account's TPM
# ceiling is rejected before it runs (413 rate_limit_exceeded). 4000 fits under
# the 8000 TPM observed on the free tier; raise this only if your account is
# on a paid tier with more headroom, or lower it if you still see 413s.
# LUCIDA_GROQ_MAX_TOKENS=4000

PORT=3001
